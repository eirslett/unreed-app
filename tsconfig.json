{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",

    "jsx": "react-jsx",

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["frontend/**/*", "backend/**/*", "server.ts"]
}
